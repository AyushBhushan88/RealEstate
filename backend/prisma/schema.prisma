// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  OWNER
  BUYER
  TENANT
  ACCOUNT_MANAGER
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  COMMERCIAL
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  ARCHIVED
}

enum ListingType {
  SALE
  RENTAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  RENT
  DEPOSIT
  SALE_PRICE
  COMMISSION
  FEE
}

enum NotificationType {
  INQUIRY_NEW
  CONTRACT_SIGNED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
  BOOKING_NEW
  BOOKING_CONFIRMED
  FAVORITE_NEW
  SAVED_SEARCH_MATCH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  role          UserRole  @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  profile       Profile?
  properties    Property[] @relation("AgentProperties")
  ownedProperties Property[] @relation("OwnerProperties")
  inquiries     Inquiry[]
  contracts     Contract[] @relation("ClientContracts")
  transactions  Transaction[]
  receivedTransactions Transaction[] @relation("TransactionRecipient")
  notifications Notification[]
  bookings      Booking[]
  agentBookings Booking[] @relation("AgentBookings")
  favorites     Favorite[]
  savedSearches SavedSearch[]
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  firstName   String?
  lastName    String?
  phoneNumber String?
  avatarUrl   String?
  bio         String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  documents   VerificationDocument[]
}

model VerificationDocument {
  id          String             @id @default(cuid())
  profileId   String
  profile     Profile            @relation(fields: [profileId], references: [id])
  type        String             // ID_CARD, PASSPORT, PAY_STUB
  url         String
  status      VerificationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([profileId])
}

model Property {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Float
  address       String
  city          String
  state         String?
  zipCode       String
  country       String        @default("USA")
  
  type          PropertyType
  listingType   ListingType
  status        ListingStatus @default(DRAFT)
  
  bedrooms      Int?
  bathrooms     Float?
  squareFeet    Int?
  lotSize       Float?
  yearBuilt     Int?
  
  agentId       String
  agent         User          @relation("AgentProperties", fields: [agentId], references: [id])
  
  ownerId       String?
  owner         User?         @relation("OwnerProperties", fields: [ownerId], references: [id])
  
  media         Media[]
  inquiries     Inquiry[]
  contracts     Contract[]
  bookings      Booking[]
  favoritedBy   Favorite[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  views         Int           @default(0)

  @@index([agentId])
  @@index([ownerId])
  @@index([status])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  filters     Json     // Stores the search criteria
  hasAlerts   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Media {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url         String
  type        String   @default("IMAGE") // IMAGE, VIDEO
  isMain      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

model Inquiry {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id])
  
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  
  name        String        // Guest name if not logged in
  email       String        // Guest email if not logged in
  phone       String?
  message     String
  status      InquiryStatus @default(NEW)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([propertyId])
  @@index([userId])
}

model Contract {
  id            String         @id @default(cuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id])
  
  clientId      String         // Buyer or Tenant
  client        User           @relation("ClientContracts", fields: [clientId], references: [id])
  
  type          ListingType    // SALE or RENTAL
  status        ContractStatus @default(DRAFT)
  
  content       String?        // JSON or URL to generated PDF
  signedAt      DateTime?
  startDate     DateTime?
  endDate       DateTime?
  amount        Float
  
  transactions  Transaction[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId])
  @@index([clientId])
}

model Transaction {
  id            String            @id @default(cuid())
  contractId    String?
  contract      Contract?         @relation(fields: [contractId], references: [id])
  
  userId        String            // Payer (User who initiated the transaction)
  user          User              @relation(fields: [userId], references: [id])

  recipientId   String?           // User who receives the funds (Agent or Owner)
  recipient     User?             @relation("TransactionRecipient", fields: [recipientId], references: [id])
  
  amount        Float
  currency      String            @default("USD")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  
  stripeId      String?           @unique
  paymentMethod String?           // card, bank_transfer, etc.

  parentId      String?           // For split transactions
  parent        Transaction?      @relation("TransactionSplits", fields: [parentId], references: [id])
  splits        Transaction[]     @relation("TransactionSplits")

  metadata      Json?             // Additional info (e.g., split percentages)
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([contractId])
  @@index([userId])
  @@index([recipientId])
  @@index([parentId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // Recipient
  user        User             @relation(fields: [userId], references: [id])
  
  type        NotificationType
  title       String
  message     String
  link        String?          // e.g., /dashboard/contracts/123
  isRead      Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g., PAYMENT_COMPLETED, CONTRACT_SIGNED
  entity      String   // e.g., Transaction, Contract
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id])
  
  userId      String        // The Buyer/Tenant who books
  user        User          @relation(fields: [userId], references: [id])
  
  agentId     String        // The Agent who will show the property
  agent       User          @relation("AgentBookings", fields: [agentId], references: [id])

  dateTime    DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([agentId])
}
