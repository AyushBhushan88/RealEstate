// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
  OWNER
  BUYER
  TENANT
  ACCOUNT_MANAGER
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  COMMERCIAL
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  ARCHIVED
}

enum ListingType {
  SALE
  RENTAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  RENT
  DEPOSIT
  SALE_PRICE
  COMMISSION
  FEE
}

enum NotificationType {
  INQUIRY_NEW
  CONTRACT_SIGNED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  role          UserRole  @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  profile       Profile?
  properties    Property[] @relation("AgentProperties")
  ownedProperties Property[] @relation("OwnerProperties")
  inquiries     Inquiry[]
  contracts     Contract[] @relation("ClientContracts")
  transactions  Transaction[]
  notifications Notification[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  firstName   String?
  lastName    String?
  phoneNumber String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Property {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Decimal       @db.Decimal(12, 2)
  address       String
  city          String
  state         String?
  zipCode       String
  country       String        @default("USA")
  
  type          PropertyType
  listingType   ListingType
  status        ListingStatus @default(DRAFT)
  
  bedrooms      Int?
  bathrooms     Decimal?      @db.Decimal(3, 1)
  squareFeet    Int?
  lotSize       Decimal?      @db.Decimal(10, 2)
  yearBuilt     Int?
  
  agentId       String
  agent         User          @relation("AgentProperties", fields: [agentId], references: [id])
  
  ownerId       String?
  owner         User?         @relation("OwnerProperties", fields: [ownerId], references: [id])
  
  media         Media[]
  inquiries     Inquiry[]
  contracts     Contract[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  views         Int           @default(0)

  @@index([agentId])
  @@index([ownerId])
  @@index([status])
}

model Media {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url         String
  type        String   @default("IMAGE") // IMAGE, VIDEO
  isMain      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

model Inquiry {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id])
  
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  
  name        String        // Guest name if not logged in
  email       String        // Guest email if not logged in
  phone       String?
  message     String
  status      InquiryStatus @default(NEW)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([propertyId])
  @@index([userId])
}

model Contract {
  id            String         @id @default(cuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id])
  
  clientId      String         // Buyer or Tenant
  client        User           @relation("ClientContracts", fields: [clientId], references: [id])
  
  type          ListingType    // SALE or RENTAL
  status        ContractStatus @default(DRAFT)
  
  content       String?        // JSON or URL to generated PDF
  signedAt      DateTime?
  startDate     DateTime?
  endDate       DateTime?
  amount        Decimal        @db.Decimal(12, 2)
  
  transactions  Transaction[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId])
  @@index([clientId])
}

model Transaction {
  id            String            @id @default(cuid())
  contractId    String?
  contract      Contract?         @relation(fields: [contractId], references: [id])
  
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  
  amount        Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  
  stripeId      String?           @unique
  paymentMethod String?           // card, bank_transfer, etc.
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([contractId])
  @@index([userId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // Recipient
  user        User             @relation(fields: [userId], references: [id])
  
  type        NotificationType
  title       String
  message     String
  link        String?          // e.g., /dashboard/contracts/123
  isRead      Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
}
